<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.awaykewatch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/awayke-watch.sh</string>
    </array>

    <!-- Запускать при старте системы... -->
    <key>RunAtLoad</key>
    <true/>

    <!-- ...и затем каждые 15 секунд. -->
    <key>StartInterval</key>
    <integer>15</integer>

    <key>StandardOutPath</key>
    <string>/var/log/awayke-watch.out.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/awayke-watch.err.log</string>
</dict>
</plist>
