<Window x:Class="Lumen.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" Height="560"
        MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Title="Lumen">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Grid.Row="0" Margin="10,10,10,6">

            <!-- General -->
            <TabItem x:Name="TabGeneral">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock x:Name="LblPoll" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtPoll" Width="80" HorizontalAlignment="Left" Margin="0,0,0,12" />

                        <TextBlock x:Name="LblGrace" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtGrace" Width="80" HorizontalAlignment="Left" Margin="0,0,0,12" />

                        <CheckBox x:Name="ChkWatchClaude" Margin="0,0,0,8" />
                        <CheckBox x:Name="ChkWatchCodex" Margin="0,0,0,12" />

                        <TextBlock x:Name="LblLanguage" Margin="0,0,0,3" />
                        <ComboBox x:Name="CmbLanguage" Width="240" HorizontalAlignment="Left" Margin="0,0,0,14" />

                        <CheckBox x:Name="ChkManageLid" Margin="0,0,0,4" />
                        <TextBlock x:Name="LblLidHint" TextWrapping="Wrap" FontSize="11"
                                   Opacity="0.75" Margin="20,0,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Triggers -->
            <TabItem x:Name="TabTriggers">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <CheckBox x:Name="ChkEnableProc" Margin="0,0,0,12" />

                        <TextBlock x:Name="LblCpu" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtCpu" Width="80" HorizontalAlignment="Left" Margin="0,0,0,14" />

                        <TextBlock x:Name="LblProcList" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtProcList" Height="140" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" Margin="0,0,0,4"
                                 FontFamily="Consolas, Courier New, monospace" />
                        <TextBlock x:Name="LblProcHint" TextWrapping="Wrap" FontSize="11" Opacity="0.75" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Safety -->
            <TabItem x:Name="TabSafety">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock x:Name="LblBatFloor" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtBatFloor" Width="80" HorizontalAlignment="Left" Margin="0,0,0,12" />

                        <TextBlock x:Name="LblCrit" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtCrit" Width="80" HorizontalAlignment="Left" Margin="0,0,0,12" />

                        <TextBlock x:Name="LblMaxHours" Margin="0,0,0,3" />
                        <TextBox x:Name="TxtMaxHours" Width="80" HorizontalAlignment="Left" Margin="0,0,0,12" />

                        <CheckBox x:Name="ChkAcOnly" Margin="0,0,0,14" />

                        <TextBlock x:Name="LblSafetyHint" TextWrapping="Wrap" FontSize="11" Opacity="0.75" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- About -->
            <TabItem x:Name="TabAbout">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18">
                        <TextBlock x:Name="LblAppName" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <TextBlock x:Name="LblTagline" Opacity="0.8" Margin="0,0,0,10" />
                        <TextBlock x:Name="LblVersion" Margin="0,0,0,14" />
                        <TextBlock x:Name="LblDescription" TextWrapping="Wrap" Margin="0,0,0,16" />
                        <TextBlock x:Name="LblConfigLabel" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <TextBox x:Name="TxtConfigPath" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" Margin="0,0,0,14" />
                        <TextBlock x:Name="LblLinks" Opacity="0.8" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,0,16,14">
            <Button x:Name="BtnSave" MinWidth="90" Height="30" Margin="0,0,10,0" IsDefault="True" />
            <Button x:Name="BtnClose" MinWidth="90" Height="30" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
